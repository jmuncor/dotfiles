#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib.sh
. "$SCRIPT_DIR/lib.sh"

ROOT="$(repo_root)"
BASH_BACKUPS=()

backup_default_bash_files() {
  local path backup n

  # RHEL ships both files in /etc/skel; move them aside so stow can link ours.
  for path in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    backup="$path.before-dotfiles"
    n=1

    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
      continue
    fi

    if [ -L "$path" ]; then
      continue
    fi

    if [ -d "$path" ]; then
      die "Cannot back up $path because it is a directory"
    fi

    while [ -e "$backup" ] || [ -L "$backup" ]; do
      backup="$path.before-dotfiles.$n"
      n=$((n + 1))
    done

    log "Backing up existing $path to $backup"
    mv "$path" "$backup"
    BASH_BACKUPS+=("$backup")
  done
}

review_bash_backups() {
  local reply backup

  if [ "${#BASH_BACKUPS[@]}" -eq 0 ]; then
    return 0
  fi

  printf '\nPrevious Bash config backups:\n'
  printf '  %s\n' "${BASH_BACKUPS[@]}"

  if [ ! -t 0 ]; then
    printf 'Review before deleting. To remove them later, run:\n'
    for backup in "${BASH_BACKUPS[@]}"; do
      printf '  rm -- %q\n' "$backup"
    done
    return 0
  fi

  printf 'Delete these backups now? [y/N] '
  if ! read -r reply; then
    reply=
  fi
  case "$reply" in
    [yY] | [yY][eE][sS])
      rm -- "${BASH_BACKUPS[@]}"
      log "Deleted backups"
      ;;
    *)
      printf 'Keeping backups.\n'
      ;;
  esac
}

PORTABLE_HERDR_HOOK='[ -f "$HOME/.claude/hooks/herdr-agent-state.sh" ] && sh "$HOME/.claude/hooks/herdr-agent-state.sh" session || true'

# herdr tells Claude Code to report its session id per pane, which is what makes
# the sidebar show which agent is working and which is waiting on me.
# This has to run after script/stow: the integration writes to
# ~/.claude/settings.json, and before stowing that path does not exist yet.
install_herdr_claude_integration() {
  local status

  if ! command_exists herdr; then
    return 0
  fi

  status="$(herdr integration status 2>/dev/null | sed -n 's/^claude: //p')"
  case "$status" in
    current*)
      log "herdr Claude integration up to date"
      ;;
    *)
      log "Installing herdr Claude integration"
      herdr integration install claude >/dev/null || warn "herdr integration install claude failed"
      ;;
  esac

  normalize_herdr_claude_hook
}

# The integration writes an absolute hook path, which is machine-specific and
# would break every other box this repo is stowed onto. Rewrite just that
# command back to a $HOME-relative, guarded form so the tracked settings.json
# stays portable and does not show up dirty after every bootstrap.
normalize_herdr_claude_hook() {
  local settings="$ROOT/claude/.claude/settings.json"

  [ -f "$settings" ] || return 0

  if ! command_exists python3; then
    warn "python3 missing; left the herdr hook path as written"
    return 0
  fi

  PORTABLE_HERDR_HOOK="$PORTABLE_HERDR_HOOK" python3 - "$settings" <<'PYEOF'
import json
import os
import sys

path = sys.argv[1]
portable = os.environ["PORTABLE_HERDR_HOOK"]

with open(path, encoding="utf-8") as handle:
    data = json.load(handle)

changed = False
hooks = data.get("hooks") or {}

for entries in hooks.values():
    for entry in entries:
        for hook in entry.get("hooks", []):
            command = hook.get("command", "")
            if "herdr-agent-state.sh" in command and command != portable:
                hook["command"] = portable
                changed = True

# `herdr integration install claude` appends its block without checking for one
# already there, so a second install leaves two identical entries and the hook
# fires twice per event. Drop exact repeats of the herdr block only; hooks that
# are not herdr's are left alone even if they happen to match.
for event, entries in hooks.items():
    seen = []
    kept = []
    for entry in entries:
        key = json.dumps(entry, sort_keys=True)
        if "herdr-agent-state.sh" in key and key in seen:
            changed = True
            continue
        seen.append(key)
        kept.append(entry)
    hooks[event] = kept

if changed:
    with open(path, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2)
        handle.write("\n")
    print("normalized the herdr Claude hook: portable path, no duplicates")
PYEOF
}

# Claude Code regenerates machine-specific blocks (autoMode) straight into the
# tracked settings.json, and this repo is public. It only reads that block from
# settings.json itself, so it cannot be moved to a gitignored sibling -- instead
# a clean filter strips it on the way into git, and a pre-commit hook catches
# the case where the filter is not configured yet. Same shape as
# normalize_herdr_claude_hook above: a tool writes local state into a shared
# file, so bootstrap arranges for git not to carry it.
#
# Both settings are local git config, which does not travel with a clone, which
# is exactly why this runs on every bootstrap.
install_repo_git_guards() {
  command_exists git || return 0

  if [ "$(git -C "$ROOT" config --local core.hooksPath 2>/dev/null || true)" = "script/hooks" ]; then
    log "Repo git hooks already enabled"
  else
    log "Enabling repo git hooks (core.hooksPath=script/hooks)"
    git -C "$ROOT" config core.hooksPath script/hooks || warn "could not set core.hooksPath"
  fi

  if [ "$(git -C "$ROOT" config --local filter.claude-settings.clean 2>/dev/null || true)" = "script/claude-settings-filter" ]; then
    log "Claude settings clean filter already enabled"
  else
    log "Enabling Claude settings clean filter"
    git -C "$ROOT" config filter.claude-settings.clean script/claude-settings-filter || warn "could not set the clean filter"
    git -C "$ROOT" config filter.claude-settings.smudge cat || warn "could not set the smudge filter"
  fi

  # The index can hold a pre-filter copy from before the filter existed.
  git -C "$ROOT" add --renormalize claude/.claude/settings.json 2>/dev/null || true
}

if [ "$#" -ne 1 ]; then
  die "Usage: $0 {macos|rhel}"
fi

case "$1" in
  macos)
    "$ROOT/script/bootstrap-macos"
    ;;
  rhel)
    "$ROOT/script/bootstrap-rhel"
    backup_default_bash_files
    ;;
  *)
    die "Unsupported bootstrap target: $1"
    ;;
esac

"$ROOT/script/stow"
install_herdr_claude_integration
install_repo_git_guards
review_bash_backups

cat <<'EOF'

Manual follow-up steps:
  1. Open a fresh shell. herdr starts on its own from ~/.bashrc.
  2. On the Mac: open terminal/OneDark.terminal and set it as the default
     profile in Terminal settings, then turn on "Use Option as Meta key" so
     Alt-H and Alt-L switch tabs.
  3. On the Mac: run `gh auth login`, then sign in to Tailscale from the menu
     bar to reach the homelab.
EOF
