#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib.sh
. "$SCRIPT_DIR/lib.sh"

ROOT="$(repo_root)"
BASH_BACKUPS=()

backup_default_bash_files() {
  local path backup n

  # RHEL ships both files in /etc/skel; move them aside so stow can link ours.
  for path in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    backup="$path.before-dotfiles"
    n=1

    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
      continue
    fi

    if [ -L "$path" ]; then
      continue
    fi

    if [ -d "$path" ]; then
      die "Cannot back up $path because it is a directory"
    fi

    while [ -e "$backup" ] || [ -L "$backup" ]; do
      backup="$path.before-dotfiles.$n"
      n=$((n + 1))
    done

    log "Backing up existing $path to $backup"
    mv "$path" "$backup"
    BASH_BACKUPS+=("$backup")
  done
}

review_bash_backups() {
  local reply backup

  if [ "${#BASH_BACKUPS[@]}" -eq 0 ]; then
    return 0
  fi

  printf '\nPrevious Bash config backups:\n'
  printf '  %s\n' "${BASH_BACKUPS[@]}"

  if [ ! -t 0 ]; then
    printf 'Review before deleting. To remove them later, run:\n'
    for backup in "${BASH_BACKUPS[@]}"; do
      printf '  rm -- %q\n' "$backup"
    done
    return 0
  fi

  printf 'Delete these backups now? [y/N] '
  if ! read -r reply; then
    reply=
  fi
  case "$reply" in
    [yY] | [yY][eE][sS])
      rm -- "${BASH_BACKUPS[@]}"
      log "Deleted backups"
      ;;
    *)
      printf 'Keeping backups.\n'
      ;;
  esac
}

if [ "$#" -ne 1 ]; then
  die "Usage: $0 {macos|rhel}"
fi

case "$1" in
  macos)
    "$ROOT/script/bootstrap-macos"
    ;;
  rhel)
    "$ROOT/script/bootstrap-rhel"
    backup_default_bash_files
    ;;
  *)
    die "Unsupported bootstrap target: $1"
    ;;
esac

"$ROOT/script/stow"
review_bash_backups

cat <<'EOF'

Manual follow-up steps:
  1. Open a fresh shell.
  2. Inside tmux, press Ctrl-b then I to install plugins.
  3. On the Mac: open terminal/OneDark.terminal and set it as the default
     profile in Terminal settings.
EOF
