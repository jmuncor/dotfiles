#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib.sh
. "$SCRIPT_DIR/lib.sh"

ROOT="$(repo_root)"
DNF_PACKAGES_FILE="$ROOT/dnf-packages.rhel.txt"

read_packages() {
  local file="$1"
  local line

  PACKAGES=()
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | \#*) continue ;;
    esac
    PACKAGES+=("$line")
  done < "$file"
}

ensure_tpm() {
  local tpm_dir="$HOME/.config/tmux/plugins/tpm"

  if [ -x "$tpm_dir/tpm" ]; then
    log "TPM already present"
    return 0
  fi

  if [ -e "$tpm_dir" ]; then
    die "TPM directory exists but $tpm_dir/tpm is missing or not executable"
  fi

  log "Cloning TPM"
  mkdir -p "$(dirname "$tpm_dir")"
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir"
}

command_exists dnf || die "dnf is required for RHEL bootstrap"
[ -f "$DNF_PACKAGES_FILE" ] || die "Missing $DNF_PACKAGES_FILE"

read_packages "$DNF_PACKAGES_FILE"
[ "${#PACKAGES[@]}" -gt 0 ] || die "$DNF_PACKAGES_FILE is empty"

log "Installing RHEL packages"
sudo dnf install -y "${PACKAGES[@]}"

if command_exists starship; then
  log "Starship already present"
else
  log "Installing Starship"
  curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

ensure_tpm
