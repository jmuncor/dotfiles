#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib.sh
. "$SCRIPT_DIR/lib.sh"

ROOT="$(repo_root)"
DNF_PACKAGES_FILE="$ROOT/dnf-packages.rhel.txt"

read_packages() {
  local file="$1"
  local line

  PACKAGES=()
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | \#*) continue ;;
    esac
    PACKAGES+=("$line")
  done < "$file"
}

command_exists dnf || die "dnf is required for RHEL bootstrap"
[ -f "$DNF_PACKAGES_FILE" ] || die "Missing $DNF_PACKAGES_FILE"

read_packages "$DNF_PACKAGES_FILE"
[ "${#PACKAGES[@]}" -gt 0 ] || die "$DNF_PACKAGES_FILE is empty"

log "Installing RHEL packages"
sudo dnf install -y "${PACKAGES[@]}"

if command_exists starship; then
  log "Starship already present"
else
  log "Installing Starship"
  curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# herdr ships no RHEL package and no Linux bottle; upstream only publishes an
# arm64 macOS build. The stowed config is harmless here, there is just no
# multiplexer to read it.
if ! command_exists herdr; then
  warn "No multiplexer on this box: herdr is macOS-only (see README)."
fi
