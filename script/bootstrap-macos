#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib.sh
. "$SCRIPT_DIR/lib.sh"

ROOT="$(repo_root)"
BREW_BASH="/opt/homebrew/bin/bash"
NEEDS_FRESH_SHELL=0

find_brew() {
  local candidate

  if command_exists brew; then
    command -v brew
    return 0
  fi

  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

if ! BREW="$(find_brew)"; then
  log "Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  BREW="$(find_brew)" || die "Homebrew installed but brew was not found"
fi

eval "$("$BREW" shellenv)"
log "Homebrew present ($("$BREW" --version | head -1))"

log "Installing tools (brew bundle)"
"$BREW" bundle --file "$ROOT/Brewfile"

if [ -x "$BREW_BASH" ]; then
  if ! grep -qxF "$BREW_BASH" /etc/shells 2>/dev/null; then
    log "Adding $BREW_BASH to /etc/shells (needs sudo)"
    echo "$BREW_BASH" | sudo tee -a /etc/shells >/dev/null
  fi

  if [ "${SHELL:-}" != "$BREW_BASH" ]; then
    log "Setting login shell to $BREW_BASH"
    chsh -s "$BREW_BASH" && NEEDS_FRESH_SHELL=1 || warn "chsh failed, run: chsh -s $BREW_BASH"
  fi
fi

if [ "$NEEDS_FRESH_SHELL" -eq 1 ] || { command_exists herdr && herdr status server >/dev/null 2>&1; }; then
  cat <<EOF

Heads up: a running herdr server keeps the shell environment its panes started
with. If Bash or Starship look wrong after setup, close all terminals or run:

  herdr server stop

Then open a fresh terminal.
EOF
fi
