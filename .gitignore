# Claude Code: only settings and statusline are tracked; the rest is runtime
# state and can hold sensitive prompts.
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/statusline.sh

# Editor swap and backups.
*.swp
*.swo
*~

# Logs and scratch files.
*.log
*.tmp

# Linux cache/trash.
.cache/

# herdr keeps session state, sockets, logs, and plugin locks next to its
# config. Only config.toml is mine to track.
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml

# Zed keeps its prompt library database and themes next to settings.json.
# Only the settings are mine to track.
zed/.config/zed/*
!zed/.config/zed/settings.json
