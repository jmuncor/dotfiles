# Claude Code MCP files can have tokens in them.
mcp-servers.json

# Codex auth and runtime state stay local.
codex/.codex/auth.json
codex/.codex/.tmp/
codex/.codex/sessions/
codex/.codex/history*

# Editor swap and backups.
*.swp
*.swo
*~

# Logs and scratch files.
*.log
*.tmp

# Linux cache/trash.
.cache/

# TPM/plugins are third-party clones under the stowed tmux config.
tmux/.config/tmux/plugins/
