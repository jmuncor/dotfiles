#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib.sh
. "$SCRIPT_DIR/lib.sh"

ROOT="$(repo_root)"
APT_PACKAGES_FILE="$ROOT/apt-packages.ubuntu.txt"

read_packages() {
  local file="$1"
  local line

  PACKAGES=()
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      '' | \#*) continue ;;
    esac
    PACKAGES+=("$line")
  done < "$file"
}

ensure_tpm() {
  local tpm_dir="$HOME/.config/tmux/plugins/tpm"

  if [ -x "$tpm_dir/tpm" ]; then
    log "TPM already present"
    return 0
  fi

  if [ -e "$tpm_dir" ]; then
    die "TPM directory exists but $tpm_dir/tpm is missing or not executable"
  fi

  log "Cloning TPM"
  mkdir -p "$(dirname "$tpm_dir")"
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir"
}

command_exists apt || die "apt is required for Ubuntu bootstrap"
[ -f "$APT_PACKAGES_FILE" ] || die "Missing $APT_PACKAGES_FILE"

read_packages "$APT_PACKAGES_FILE"
[ "${#PACKAGES[@]}" -gt 0 ] || die "$APT_PACKAGES_FILE is empty"

log "Updating apt package index"
sudo apt update

log "Installing Ubuntu packages"
sudo apt install -y "${PACKAGES[@]}"

if command_exists starship; then
  log "Starship already present"
else
  log "Installing Starship"
  curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

ensure_tpm
